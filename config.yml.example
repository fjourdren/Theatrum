application:
  public_path: "http://localhost:8080"
  all_streams_playlist:
    enabled: true
    path: "all_streams.m3u8"

# Server's ports
server:
  http: 8080 # Also used by HLS
  rtmp: 1935
  rtmp_config:
    reconnect_delay: 30  # Seconds to wait before cleaning up disconnected stream
    cleanup_delay: 30    # Seconds to wait before removing stream files

# ────────────────
# Quality profiles
quality_profiles: &QUALITY_PROFILES
  low: &LOW
    width: 640
    height: 360
    framerate: 24
    bitrate: "800k"
    codec: "libx264"
    audio:
      bitrate: "96k"
      codec: "aac"

  medium: &MEDIUM
    width: 1280
    height: 720
    framerate: 30
    bitrate: "2500k"
    codec: "libx264"
    audio:
      bitrate: "128k"
      codec: "aac"

  high: &HIGH
    width: 1920
    height: 1080
    framerate: 30
    bitrate: "5000k"
    codec: "libx264"
    audio:
      bitrate: "192k"
      codec: "aac"

# ────────────────
# Stream templates
stream_templates:
  default:  # When there is not quality, then the default directory is used in the storage path
    stream: &default_stream_config
      type: video_encoded
      path: "livestreams/{username}"
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 6
  multiquality:
    stream: &multiquality_stream_config
      type: video_encoded
      path: "livestreams/{username}"
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 6
  video:
    stream: &video_unencoded_config
      type: video_unencoded
      video_input_path: "raw_videos/{username}"
      path: "records/{username}"
      delete_after_encoding: false
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 6
  # Live stream with multi-quality transcoding (requires CPU for real-time encoding)
  live:
    stream: &live_stream_config
      type: live
      path: "live/{username}"
      live_stream_key: "your-secure-rtmp-secret-key"  # Secret key for XOR authentication
      auth_token_template: "{username}"               # Template for XOR input (uses URL variables)
      qualities:                                       # Optional: omit for passthrough (codec copy)
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 2  # Lower for live streaming
          window_size: 5       # Number of segments in the live playlist (default: 3)

  # Live stream with passthrough (no transcoding, lowest latency)
  live_passthrough:
    stream: &live_passthrough_config
      type: live
      path: "live/{username}"
      live_stream_key: "your-secure-rtmp-secret-key"
      auth_token_template: "{username}"
      distribution:
        hls:
          segment_duration: 2
          window_size: 3       # Number of segments in the live playlist (default: 3)
      viewers:                   # Concurrent viewer count (live streams only)
        enabled: true
        window: 30               # Seconds of inactivity before a viewer is considered gone
      views:                     # Total view count (all stream types)
        enabled: true
        window: 30               # Seconds of inactivity before a new visit counts as a new view (0 = instant)

  # Live stream with recording enabled
  live_recorded:
    stream: &live_recorded_config
      type: live
      path: "live/{username}/{%STARTING_DATE%}"
      live_stream_key: "your-secure-rtmp-secret-key"
      auth_token_template: "{username}"
      distribution:
        hls:
          segment_duration: 2
          window_size: 5
      record:
        enabled: true
        path: "recordings/{username}/{%STARTING_DATE%}"  # Same placeholders as stream path

  # DASH-only live stream (MPEG-DASH without HLS)
  live_dash:
    stream: &live_dash_config
      type: live
      path: "live/{username}"
      live_stream_key: "your-secure-rtmp-secret-key"
      auth_token_template: "{username}"
      distribution:
        dash:
          segment_duration: 2
          window_size: 5

  # Dual-mode live stream (both HLS and DASH from a single FFmpeg process)
  # Both formats share fMP4/CMAF segments (.m4s). HLS uses fMP4 instead of .ts.
  live_dual:
    stream: &live_dual_config
      type: live
      path: "live/{username}"
      live_stream_key: "your-secure-rtmp-secret-key"
      auth_token_template: "{username}"
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 2
          window_size: 5
        dash:
          segment_duration: 2  # Must match HLS segment_duration in dual mode
          window_size: 5

  # VOD encoding with DASH output
  video_dash:
    stream: &video_dash_config
      type: video_unencoded
      video_input_path: "raw_videos/{username}"
      path: "records/{username}"
      delete_after_encoding: false
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        dash:
          segment_duration: 6

# ────────────────
# All streams endpoints
channels:
  "/user/{username}":
    stream:
      <<: *default_stream_config
  "/premium/{username}":
    stream:
      <<: *multiquality_stream_config
  "/video/{username}":
    stream:
      <<: *video_unencoded_config
  "/live/{username}":
    stream:
      <<: *live_stream_config

  # Restream: pull from external RTMP URL (passthrough, no transcoding)
  "/restream/mystream":
    stream:
      type: restream
      source_url: "rtmp://external-server/live/stream_key"
      path: "restream/mystream"
      distribution:
        hls:
          segment_duration: 2
          window_size: 5

  # Restream with multi-quality transcoding
  # "/restream/premium":
  #   stream:
  #     type: restream
  #     source_url: "rtmp://external-server/live/stream_key"
  #     path: "restream/premium"
  #     qualities:
  #       low: *LOW
  #       medium: *MEDIUM
  #       high: *HIGH
  #     distribution:
  #       hls:
  #         segment_duration: 2
  #         window_size: 5

  # Restream with recording
  # "/restream/recorded":
  #   stream:
  #     type: restream
  #     source_url: "rtmp://external-server/live/stream_key"
  #     path: "restream/recorded/{%STARTING_DATE%}"
  #     distribution:
  #       hls:
  #         segment_duration: 2
  #         window_size: 5
  #     record:
  #       enabled: true
  #       path: "recordings/restream/{%STARTING_DATE%}"
