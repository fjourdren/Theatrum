# ════════════════════════════════════════════════════════════════════════
# Theatrum — quick-test configuration
#
# Three channels, one for each way content gets in. Copy to config.yml,
# run, and every URL below works with no further setup.
#
#   java -jar target/theatrum-2.0.jar --config config.yml.example
#
#   1. /vod/{video_id}    transcode — drop an .mp4 in data/raw_videos/{id}/
#                         and Theatrum encodes it to a 3-quality HLS ladder
#   2. /watch/{video_id}  pre-transcoded — segments an external pipeline
#                         already produced, served as-is
#   3. /live/{username}   RTMP ingest that records — live while publishing,
#                         then the same URL serves the full VOD
#
# Browser player:  http://localhost:8090/          (frontend/index.html)
# Channel index:   http://localhost:8090/all_streams.m3u8
#
# The field-by-field reference is docs/configuration.md; examples/ holds
# five configurations shaped after real platforms.
# ════════════════════════════════════════════════════════════════════════

application:
  public_path: "http://localhost:8090"   # What the aggregated playlist advertises
  all_streams_playlist:
    enabled: true
    path: "all_streams.m3u8"

# Server ports
server:
  http: 8090               # Also serves HLS/DASH and the frontend
  rtmp: 1935
  rtmp_config:
    reconnect_delay: 10    # Short delays keep the test loop fast
    cleanup_delay: 10

# ────────────────
# Quality profiles — the ladder every transcoding channel below reuses
quality_profiles: &QUALITY_PROFILES
  low: &LOW
    width: 640
    height: 360
    framerate: 24
    bitrate: "800k"
    codec: "libx264"
    audio:
      bitrate: "96k"
      codec: "aac"

  medium: &MEDIUM
    width: 1280
    height: 720
    framerate: 30
    bitrate: "2500k"
    codec: "libx264"
    audio:
      bitrate: "128k"
      codec: "aac"

  high: &HIGH
    width: 1920
    height: 1080
    framerate: 30
    bitrate: "5000k"
    codec: "libx264"
    audio:
      bitrate: "192k"
      codec: "aac"

# ────────────────
# Channels
channels:

  # ── 1. VOD, transcoded by Theatrum ────────────────────────────────────
  # Scans data/raw_videos/{video_id}/ at boot and encodes what it finds
  # into data/encoded/{video_id}/. Detection runs at startup only, so add
  # files before launching, not while running.
  #
  #   mkdir -p data/raw_videos/demo
  #   cp src/test/resources/testdata/test.mp4 data/raw_videos/demo/
  #   # restart, wait for "Encoding completed", then:
  #   vlc http://localhost:8090/vod/demo/master.m3u8
  "/vod/{video_id}":
    stream:
      type: video_unencoded
      video_input_path: "raw_videos/{video_id}"
      path: "encoded/{video_id}"
      delete_after_encoding: false   # Keep the source so the test is repeatable
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 6        # Longer than live: nobody is waiting
      views:
        enabled: true
        window: 10

  # ── 2. VOD, already transcoded elsewhere ──────────────────────────────
  # Theatrum only serves what is on disk — no FFmpeg involved. Point it at
  # a directory that already holds a master playlist and its segments.
  #
  #   vlc http://localhost:8090/watch/demo/master.m3u8
  "/watch/{video_id}":
    stream:
      type: video_encoded
      path: "library/{video_id}"
      qualities:                     # Must name the directories that exist on disk
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 6        # Must match how the segments were cut
      views:
        enabled: true
        window: 10

  # ── 3. Live RTMP that becomes a VOD ───────────────────────────────────
  # `record.enabled` with no `record.path` means the recording is finalised
  # in place: while you publish the URL serves a rolling live window, and
  # once you stop it serves the whole broadcast from the same URL.
  #
  # The stream key is XOR(username, live_stream_key) in lowercase hex — for
  # username `alice` and the key below that is 15091a170e (docs/ingest.md):
  #
  #   ffmpeg -re -i data/raw_videos/demo/input.mp4 -c copy -f flv \
  #     rtmp://localhost:1935/live/alice/15091a170e
  #   vlc http://localhost:8090/live/alice/master.m3u8
  "/live/{username}":
    stream:
      type: live
      path: "live/{username}"
      live_stream_key: "testkey"     # CHANGE THIS — anyone holding it can publish
      auth_token_template: "{username}"
      qualities:
        low: *LOW
        medium: *MEDIUM
        high: *HIGH
      distribution:
        hls:
          segment_duration: 2        # Short segments: lower latency
          window_size: 5
      record:
        enabled: true                # No path = finalise in place, same URL
      viewers:
        enabled: true
        window: 10                   # Counts only after 10s of continuous watching
      views:
        enabled: true
        window: 10
      thumbnail:
        enabled: true
        interval: 5                  # http://localhost:8090/live/alice/thumbnail.png
